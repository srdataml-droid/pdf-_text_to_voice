{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(python3:*)",
      "Bash(pip install:*)",
      "Bash(uvicorn:*)",
      "Bash(curl -sf localhost:*)",
      "Bash(pytest:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
